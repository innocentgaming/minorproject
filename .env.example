# SDVS Environment Configuration Example
# Copy this file to .env and configure for your local environment.

# Application Settings
SDVS_ENV=production
SDVS_PORT=8501
SDVS_HOST=localhost

# Storage Configuration
SDVS_DATA_DIR=data
SDVS_MAX_UPLOAD_SIZE_MB=50

# Cryptographic Tuning (Scrypt KDF)
SDVS_SCRYPT_N=32768
SDVS_SCRYPT_R=8
SDVS_SCRYPT_P=1

# Security Audit Configuration
SDVS_LOG_LEVEL=INFO
SDVS_MAX_LOG_ENTRIES=1000
